    "leaflet": "1.9.4",
    "next": "15.5.29",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "react-leaflet": "5.0.0",
    "recharts": "3.11.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.13",
    "@types/leaflet": "1.9.20",
    "@types/node": "22.18.6",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "prisma": "6.19.3",
    "tailwindcss": "4.1.13",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
