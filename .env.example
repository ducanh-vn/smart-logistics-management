# PostgreSQL. On Neon: DATABASE_URL = the "Pooled connection" string, DIRECT_URL = the direct one (without "-pooler").
# On a local PostgreSQL both can be the same, e.g. postgresql://postgres:postgres@localhost:5432/slms
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/slms"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/slms"
# Secret used to sign login sessions (any long random string)
AUTH_SECRET="change-me-to-a-long-random-string"
# Demo mode: shows test accounts on the login page, the OTP on the driver app and the GPS simulator.
# Set to "0" (or remove) on a public deployment.
NEXT_PUBLIC_DEMO_MODE="1"
